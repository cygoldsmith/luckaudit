{
  "name": "luckaudit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "next start --hostname 0.0.0.0",
    "snapshots": "node scripts/capture-snapshots.mjs",
    "library": "node --max-old-space-size=2048 --import tsx scripts/build-library.mts",
    "library:server": "node scripts/build-library.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
